+fn resolve_agent_executable(
+    kind: crate::detect::Agent,
+    requested: Option<String>,
+    codex_allowlist: &[PathBuf],
+) -> Result<String, AgentStartError> {
+    let Some(requested) = requested else {
+        return Ok(crate::detect::interactive_agent_executable(kind).to_string());
+    };
+    if kind != crate::detect::Agent::Codex {
+        return Err(AgentStartError::ExecutableUnsupportedKind(
+            crate::detect::agent_label(kind).to_string(),
+        ));
+    }
+    let path = Path::new(&requested);
+    if !path.is_absolute() {
+        return Err(AgentStartError::ExecutableNotAbsolute(requested));
+    }
+    if !codex_allowlist.iter().any(|allowed| allowed == path) {
+        return Err(AgentStartError::ExecutableNotAllowed(requested));
+    }
+    if !selected_executable_exists(path) {
+        return Err(AgentStartError::ExecutableUnavailable(requested));
+    }
+    Ok(requested)
+}
+
+fn selected_executable_exists(path: &Path) -> bool {
+    let Ok(metadata) = path.metadata() else {
+        return false;
+    };
+    if !metadata.is_file() {
+        return false;
+    }
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        metadata.permissions().mode() & 0o111 != 0
+    }
+    #[cfg(windows)]
+    {
+        true
+    }
+}
+
