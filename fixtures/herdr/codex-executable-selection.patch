 pub(super) enum AgentStartError {
     InvalidName,
     UnsupportedKind(String),
     InvalidArgument,
+    ExecutableUnsupportedKind(String),
+    ExecutableNotAbsolute(String),
+    ExecutableNotAllowed(String),
+    ExecutableUnavailable(String),
     InvalidTimeout,
     TargetNotFound(String),
     TargetBusy(String),
